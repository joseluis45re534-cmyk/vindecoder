# Copy to `.dev.vars` for local dev (gitignored). In production, set each as a
# Cloudflare Pages secret:  npx wrangler pages secret put NAME

# --- Admin panel ---
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-32-byte-random-hex

# --- Payments: Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Payments: PayPal ---
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_ENV=sandbox   # or: live

# --- Blog content (AutoSEO Content API) — SERVER-ONLY, never NEXT_PUBLIC_ ---
# Read-only key from AutoSEO; powers /blog. Never expose to the browser.
AUTOSEO_BLOG_API_KEY=
# Optional HMAC secret for the publish webhook (/api/autoseo/revalidate).
AUTOSEO_REVALIDATE_SECRET=

# --- SEO keyword discovery (DataForSEO Labs) ---
# Basic-auth credentials from https://app.dataforseo.com/api-access — server-only.
# Powers the automated keyword-research → blog pipeline (~$0.01 per API call).
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=...
# DATAFORSEO_BASE=https://api.dataforseo.com   # optional override

# --- Blog automation (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
# Bearer token required to trigger /api/cron/blog from a scheduler
CRON_SECRET=replace-with-random-token

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://carvinlookup.us

# --- Analytics (public, inlined at BUILD time — set in Cloudflare Pages build vars) ---
NEXT_PUBLIC_GA_ID=            # GA4 measurement ID, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GADS_ID=        # optional Google Ads tag, e.g. AW-XXXXXXXXX

# --- Supabase Auth (user accounts + email confirmation) ---
# Project → Settings → API. The URL + anon key are public (used in the browser);
# the service_role key is secret (server-only) — NEVER expose it as NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Vehicle data (auto.dev) ---
AUTODEV_API_KEY=

# --- Vehicle data (VinCheck Partner API v1) — ACTIVE provider, server-only ---
# NEVER expose as NEXT_PUBLIC_. Use the vc_test_ key in dev (free, sample data),
# the vc_live_ key in production (charged per report; keep a positive balance).
VINCHECK_API_KEY=vc_test_...
VINCHECK_API_BASE=https://vincheck.it.com/api/v1
VINCHECK_TIMEOUT_MS=30000

# --- Vehicle data (GoodCar B2B API) — LEGACY, superseded by VinCheck ---
GOODCAR_API_BASE=https://goodcar.com
GOODCAR_API_KEY=
GOODCAR_AUTH_HEADER=Authorization        # or X-API-Key
GOODCAR_AUTH_PREFIX=Bearer               # or empty
GOODCAR_TIMEOUT_MS=10000
PREVIEW_RATE_LIMIT_PER_HOUR=20           # per IP, anti-scrape
REPORT_CACHE_TTL_DAYS=30
