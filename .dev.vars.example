# Copy to `.dev.vars` for local dev (gitignored). In production, set each as a
# Cloudflare Pages secret:  npx wrangler pages secret put NAME

# --- Admin panel ---
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-32-byte-random-hex

# --- Payments: Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Payments: PayPal ---
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_ENV=sandbox   # or: live

# --- Blog automation (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
# Bearer token required to trigger /api/cron/blog from a scheduler
CRON_SECRET=replace-with-random-token

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://carvinlookup.us

# --- Vehicle data (auto.dev) ---
AUTODEV_API_KEY=

# --- Vehicle data (GoodCar B2B API) — server-only, NEVER NEXT_PUBLIC_ ---
GOODCAR_API_BASE=https://goodcar.com
GOODCAR_API_KEY=
GOODCAR_AUTH_HEADER=Authorization        # or X-API-Key
GOODCAR_AUTH_PREFIX=Bearer               # or empty
GOODCAR_TIMEOUT_MS=10000
PREVIEW_RATE_LIMIT_PER_HOUR=20           # per IP, anti-scrape
REPORT_CACHE_TTL_DAYS=30
